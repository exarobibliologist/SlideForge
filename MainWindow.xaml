<Window x:Class="SlideForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlideForge Image &amp; Media Viewer v.1.7.5.2"
        Icon="SlideForge.ico"
        Width="1280" Height="700"
        MinWidth="960" MinHeight="560"
        Background="#0B0B0E"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseMove="Window_MouseMove"
        AllowDrop="True"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Dark HUD Button Style -->
        <Style x:Key="HudButton" TargetType="Button">
            <Setter Property="Background" Value="#262630"/>
            <Setter Property="Foreground" Value="#F0F0F5"/>
            <Setter Property="BorderBrush" Value="#3E3E4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A4A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5E81AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ContextMenu & MenuItem Styles for + File/Folder, Playlist, and Sort Dropdowns -->
        <Style x:Key="DarkPopupMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#1B1B24"/>
            <Setter Property="Foreground" Value="#F0F0F5"/>
            <Setter Property="BorderBrush" Value="#4A4A5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkPopupMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0F0F5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="checkMark"
                                           Grid.Column="0"
                                           Text="✓"
                                           Foreground="#88C0D0"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#343446"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill RadioButton Style (Inside Pull-Up Navigation Bar) -->
        <Style x:Key="FilterPill" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="#B8B8C8"/>
            <Setter Property="BorderBrush" Value="#343444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="MediaFilterGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#2E2E3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#3B5B84"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#7CA1D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gold-Accented Filter Pill CheckBox Style for "★ Favs Only" in Bottom Bar -->
        <Style x:Key="FavFilterPill" TargetType="CheckBox">
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="#FFD166"/>
            <Setter Property="BorderBrush" Value="#4A4230"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#2E2A22"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#5E491E"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#FFD166"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark HUD CheckBox Style -->
        <Style x:Key="HudCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- 1. INTERACTIVE VIEWPORT -->
        <Grid x:Name="ViewportContainer"
              Background="#0B0B0E"
              ClipToBounds="True"
              MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
              MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
              MouseRightButtonDown="Viewport_MouseRightButtonDown"
              MouseRightButtonUp="Viewport_MouseRightButtonUp"
              MouseMove="Viewport_MouseMove"
              MouseWheel="Viewport_MouseWheel"
              MouseDown="Viewport_MouseDown">

            <!-- User Interactive Zoom/Pan Matrix Container -->
            <Grid x:Name="StageContainer"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <MatrixTransform x:Name="StageMatrixTransform"/>
                </Grid.RenderTransform>

                <!-- Back Layer (Outgoing slide snapshot for Transitions) -->
                <Image x:Name="ImgBack"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5"
                       Opacity="0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BackScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="BackTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- Front Image / Animated GIF Layer -->
                <Image x:Name="ImgFront"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5"
                       Opacity="1">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="FrontScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="FrontTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- LibVLC Direct-to-WPF Video Surface Layer -->
                <Image x:Name="VideoSurface"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5"
                       Visibility="Collapsed">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="VideoScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="VideoTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Subtle Camera Shutter Flash Overlay for Frame Capture -->
            <Border x:Name="SnapshotFlashOverlay"
                    Background="#FFFFFF"
                    Opacity="0"
                    IsHitTestVisible="False"/>

            <!-- Empty State Prompt -->
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="Drop Folders, Images, GIFs, or Videos Here"
                           Foreground="#6C6C7E"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="LibVLC Engine Active (200% Audio Overdrive + SMPlayer Subtitle Finder)  •  Right-Click+Pull: Zoom  •  Wheel (Zoomed): Pan"
                           Foreground="#4C4C5A"
                           FontSize="13"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 2. COMPACT SINGLE-ROW TOP AUTO-HIDING HUD BAR -->
        <Border x:Name="TopHud"
                VerticalAlignment="Top"
                Background="#DF141419"
                BorderBrush="#2A2A35"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel VerticalAlignment="Center">

                <!-- 1. Consolidated "+ File/Folder ▾" Drop-Down Menu Button -->
                <Button x:Name="BtnFileFolder"
                        Content="📂 + File/Folder ▾"
                        Style="{StaticResource HudButton}"
                        Click="BtnFileFolder_Click"
                        ToolTip="Open or add folders, files, subfolder toggle, and Windows Explorer integration">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="FileFolderMenu" Style="{StaticResource DarkPopupMenu}">
                            <MenuItem Header="📂 Open Folder (New Session)..."
                                      Style="{StaticResource DarkPopupMenuItem}"
                                      Click="BtnOpenFolder_Click"/>
                            <MenuItem Header="➕ Add Folder to Pool..."
                                      Style="{StaticResource DarkPopupMenuItem}"
                                      Click="BtnAddFolder_Click"/>
                            <MenuItem Header="📄 Add Individual Files..."
                                      Style="{StaticResource DarkPopupMenuItem}"
                                      Click="BtnAddFiles_Click"/>
                            <Separator Background="#323242" Margin="4,3"/>
                            <MenuItem x:Name="MnuSubfolders"
                                      Header="Include Subfolders"
                                      IsCheckable="True"
                                      Style="{StaticResource DarkPopupMenuItem}"
                                      Checked="ChkSubfolders_Changed"
                                      Unchecked="ChkSubfolders_Changed"/>
                            <Separator Background="#323242" Margin="4,3"/>
                            <MenuItem x:Name="MnuExplorerMenu"
                                      Header="📌 Enable 'Open Folder in SlideForge' in Explorer"
                                      IsCheckable="True"
                                      Style="{StaticResource DarkPopupMenuItem}"
                                      Click="MnuExplorerMenu_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- 2. Shuffle Controls -->
                <CheckBox x:Name="ChkShuffle"
                          Content="🔀 Randomize"
                          IsChecked="True"
                          Style="{StaticResource HudCheckBox}"
                          Checked="ChkShuffle_Changed"
                          Unchecked="ChkShuffle_Changed"/>
                <Button Content="🎲 Reshuffle" Style="{StaticResource HudButton}" Click="BtnReshuffle_Click" ToolTip="Generate fresh random order (S)"/>

                <Rectangle Width="1" Height="20" Fill="#343442" Margin="5,0"/>

                <!-- 3. Playback & Timer -->
                <Button Content="⏮" Style="{StaticResource HudButton}" Click="BtnPrev_Click" ToolTip="Previous Slide (Left Arrow)"/>
                <Button x:Name="BtnPlayPause" Content="▶ Play" Style="{StaticResource HudButton}" Click="BtnPlayPause_Click" ToolTip="Start/Pause Slideshow (Spacebar or P)"/>
                <Button Content="⏭" Style="{StaticResource HudButton}" Click="BtnNext_Click" ToolTip="Next Slide (Right Arrow)"/>

                <TextBlock Text="Delay:" Foreground="#B0B0C0" VerticalAlignment="Center" Margin="5,0,3,0" FontSize="12"/>
                <TextBox x:Name="TxtInterval"
                         Text="5"
                         Width="32"
                         IsTabStop="False"
                         Background="#1E1E26"
                         Foreground="#FFFFFF"
                         BorderBrush="#3E3E4E"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         TextChanged="TxtInterval_TextChanged"/>

                <Rectangle Width="1" Height="20" Fill="#343442" Margin="5,0"/>

                <!-- 4. Transitions & Ken Burns -->
                <TextBlock Text="Transition:" Foreground="#B0B0C0" VerticalAlignment="Center" Margin="2,0,4,0" FontSize="12"/>
                <ComboBox x:Name="CmbTransition"
                          Width="106"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          Margin="2,1"
                          FontSize="12"
                          Focusable="False">
                    <ComboBoxItem Content="Cross-Fade"/>
                    <ComboBoxItem Content="Slide / Push"/>
                    <ComboBoxItem Content="Zoom-Fade"/>
                    <ComboBoxItem Content="Random Mix"/>
                    <ComboBoxItem Content="None (Instant)"/>
                </ComboBox>

                <CheckBox x:Name="ChkKenBurns"
                          Content="🎥 Ken Burns"
                          Style="{StaticResource HudCheckBox}"
                          Checked="ChkKenBurns_Changed"
                          Unchecked="ChkKenBurns_Changed"
                          ToolTip="Slow pan-and-zoom effect during slideshow (K)"/>

                <Rectangle Width="1" Height="20" Fill="#343442" Margin="5,0"/>

                <!-- 5. Favorites & Export -->
                <Button x:Name="BtnToggleFav" Content="☆ Fav" Style="{StaticResource HudButton}" Click="BtnToggleFav_Click" ToolTip="Bookmark / Favorite current media (F)"/>
                <Button Content="📤 Export Favs" Style="{StaticResource HudButton}" Click="BtnExportFavorites_Click" ToolTip="Copy all favorited files to a folder"/>

                <!-- 6. Consolidated "Playlist ▾" Drop-Down Menu Button -->
                <Button x:Name="BtnPlaylist"
                        Content="📋 Playlist ▾"
                        Style="{StaticResource HudButton}"
                        Click="BtnPlaylist_Click"
                        ToolTip="Save or Load a Multi-Folder Slideshow Playlist">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="PlaylistMenu" Style="{StaticResource DarkPopupMenu}">
                            <MenuItem Header="💾 Save Playlist..."
                                      Style="{StaticResource DarkPopupMenuItem}"
                                      Click="BtnSavePlaylist_Click"/>
                            <MenuItem Header="📂 Load Playlist..."
                                      Style="{StaticResource DarkPopupMenuItem}"
                                      Click="BtnLoadPlaylist_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#343442" Margin="5,0"/>

                <!-- 7. Filmstrip Pin, Zoom Reset & Fullscreen -->
                <Button x:Name="BtnPinFilmstrip" Content="🎞 Strip" Style="{StaticResource HudButton}" Click="BtnPinFilmstrip_Click" ToolTip="Show/Pin bottom navigation filmstrip (T)"/>
                <Button Content="🔍 100%" Style="{StaticResource HudButton}" Click="BtnResetZoom_Click" ToolTip="Reset Zoom (R or Middle-Click)"/>
                <Button x:Name="BtnFullscreen" Content="⛶ Full" Style="{StaticResource HudButton}" Click="BtnFullscreen_Click" ToolTip="Fullscreen (F11)"/>
            </WrapPanel>
        </Border>

        <!-- 3. BOTTOM STACK: VIDEO BAR + COLLAPSIBLE FILMSTRIP DRAWER + STATUS BAR -->
        <StackPanel x:Name="BottomOverlayStack" VerticalAlignment="Bottom">

            <!-- Contextual LibVLC Video Transport Bar -->
            <Border x:Name="VideoControlBar"
                    Background="#EE14141C"
                    BorderBrush="#2E2E3E"
                    BorderThickness="0,1,0,0"
                    Padding="10,6"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Video Transport Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                        <Button x:Name="BtnVideoPlayPause"
                                Content="⏸ Video"
                                Width="66"
                                Style="{StaticResource HudButton}"
                                Click="BtnVideoPlayPause_Click"
                                ToolTip="Play/Pause Video ( Space )"/>
                        <Button Content="⏪ -30s"
                                Style="{StaticResource HudButton}"
                                Click="BtnRewind30_Click"
                                ToolTip="Rewind 30 Seconds ( [ )"/>
                        <Button Content="+30s ⏩"
                                Style="{StaticResource HudButton}"
                                Click="BtnFastForward30_Click"
                                ToolTip="Fast-Forward 30 Seconds ( ] )"/>
                        <Button Content="⏮ -1f"
                                Style="{StaticResource HudButton}"
                                Click="BtnStepPrevFrame_Click"
                                ToolTip="Pause &amp; Step Backward 1 Frame ( , )"/>
                        <Button Content="+1f ⏭"
                                Style="{StaticResource HudButton}"
                                Click="BtnStepNextFrame_Click"
                                ToolTip="Pause &amp; Step Forward 1 Exact Frame ( . )"/>
                        <Button Content="📷 Snap"
                                Style="{StaticResource HudButton}"
                                Click="BtnSnapshot_Click"
                                ToolTip="Capture Video Frame to PNG &amp; Clipboard (C = Full Res, Shift+C = Zoomed View)"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtVideoTime"
                               Grid.Column="1"
                               Text="00:00 / 00:00"
                               Foreground="#D0D0DE"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Slider x:Name="VideoSeekSlider"
                            Grid.Column="2"
                            Minimum="0"
                            Maximum="100"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Focusable="False"
                            PreviewMouseLeftButtonDown="VideoSeekSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="VideoSeekSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="VideoSeekSlider_ValueChanged"/>

                    <!-- Multi-Audio Track Selector -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                        <TextBlock x:Name="TxtAudioBadge"
                                   Text="🔊 Audio:"
                                   Foreground="#A3BE8C"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbAudioTracks"
                                  Width="98"
                                  FontSize="11"
                                  Focusable="False"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbAudioTracks_SelectionChanged"
                                  ToolTip="Select Audio Stream / Language Track"/>
                    </StackPanel>

                    <!-- Subtitle Track Selector + External .SRT Loader + SMPlayer-style Subtitle Finder -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                        <TextBlock x:Name="TxtSubBadge"
                                   Text="💬 Sub:"
                                   Foreground="#88C0D0"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbSubtitleTracks"
                                  Width="98"
                                  FontSize="11"
                                  Focusable="False"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbSubtitleTracks_SelectionChanged"
                                  ToolTip="Select Subtitle Track (Press V to cycle)"/>
                        <Button Content="➕.SRT"
                                Style="{StaticResource HudButton}"
                                Padding="6,4"
                                FontSize="11"
                                Click="BtnLoadExternalSub_Click"
                                ToolTip="Load a local .SRT / .ASS / .VTT subtitle file"/>
                        <Button Content="🔍 Find"
                                Style="{StaticResource HudButton}"
                                Padding="6,4"
                                FontSize="11"
                                Click="BtnFindSubtitles_Click"
                                ToolTip="Find &amp; Download Subtitles online using SMPlayer OSDB MovieHash (Shift+V)"/>
                    </StackPanel>

                    <Button x:Name="BtnMute"
                            Grid.Column="5"
                            Content="🔊"
                            Style="{StaticResource HudButton}"
                            Click="BtnMute_Click"
                            MouseWheel="VolumeControl_MouseWheel"
                            Margin="4,0,4,0"
                            ToolTip="Mute / Unmute Video Audio (M) — Scroll Wheel for Volume"/>

                    <!-- VLC Overdrive Volume Slider (0% - 200%) + Live Boost Readout -->
                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                MouseWheel="VolumeControl_MouseWheel">
                        <Slider x:Name="VolumeSlider"
                                Width="80"
                                Minimum="0"
                                Maximum="200"
                                Value="100"
                                Ticks="100"
                                TickPlacement="BottomRight"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Focusable="False"
                                ValueChanged="VolumeSlider_ValueChanged"
                                ToolTip="VLC Audio Volume &amp; Overdrive Boost (0% – 200% | Keys: + / - or Mouse Wheel)"/>
                        <TextBlock x:Name="TxtVolumePercent"
                                   Text="100%"
                                   Width="36"
                                   Foreground="#D0D0DE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,0"
                                   ToolTip="Above 100% engages LibVLC software audio overdrive for quiet videos"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkWaitVideoFinish"
                              Grid.Column="7"
                              Content="Play Full"
                              IsChecked="True"
                              Style="{StaticResource HudCheckBox}"
                              Margin="6,0,0,0"
                              ToolTip="When checked, the slideshow waits for the video to finish before advancing"/>
                </Grid>
            </Border>

            <!-- Slide-Up Thumbnail Filmstrip Drawer -->
            <Border x:Name="FilmstripDrawer"
                    Background="#F0101016"
                    BorderBrush="#2E2E3C"
                    BorderThickness="0,1,0,0"
                    Height="0"
                    Opacity="0"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <Grid Height="156">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FILMSTRIP HEADER: CONDITIONAL SORT MENU + FAVS ONLY + FILE TYPE FILTER PILLS -->
                    <Border Grid.Row="0"
                            Background="#181822"
                            BorderBrush="#282836"
                            BorderThickness="0,0,0,1"
                            Padding="10,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Conditional Sort Dropdown Button -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button x:Name="BtnSortMedia"
                                        Content="↕ Sort: Name (A–Z) ▾"
                                        Style="{StaticResource HudButton}"
                                        Padding="8,2"
                                        FontSize="11"
                                        Click="BtnSortMedia_Click"
                                        ToolTip="Sort filmstrip by Name, Location/Path, File Size, or Timestamp (plus Reverse of each)">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="SortMediaMenu" Style="{StaticResource DarkPopupMenu}">
                                            <MenuItem x:Name="MnuSortNameAsc" Header="🔤 Name (A → Z)" Tag="NameAsc" IsCheckable="True" IsChecked="True" Style="{StaticResource DarkPopupMenuItem}" Click="SortMenuItem_Click"/>
                                            <MenuItem x:Name="MnuSortNameDesc" Header="🔤 Name (Z → A)" Tag="NameDesc" IsCheckable="True" Style="{StaticResource DarkPopupMenuItem}" Click="SortMenuItem_Click"/>
                                            <Separator Background="#323242" Margin="4,3"/>
                                            <MenuItem x:Name="MnuSortLocationAsc" Header="📁 Location / Path (A → Z)" Tag="LocationAsc" IsCheckable="True" Style="{StaticResource DarkPopupMenuItem}" Click="SortMenuItem_Click"/>
                                            <MenuItem x:Name="MnuSortLocationDesc" Header="📁 Location / Path (Z → A)" Tag="LocationDesc" IsCheckable="True" Style="{StaticResource DarkPopupMenuItem}" Click="SortMenuItem_Click"/>
                                            <Separator Background="#323242" Margin="4,3"/>
                                            <MenuItem x:Name="MnuSortSizeAsc" Header="⚖ Size (Smallest → Largest)" Tag="SizeAsc" IsCheckable="True" Style="{StaticResource DarkPopupMenuItem}" Click="SortMenuItem_Click"/>
                                            <MenuItem x:Name="MnuSortSizeDesc" Header="⚖ Size (Largest → Smallest)" Tag="SizeDesc" IsCheckable="True" Style="{StaticResource DarkPopupMenuItem}" Click="SortMenuItem_Click"/>
                                            <Separator Background="#323242" Margin="4,3"/>
                                            <MenuItem x:Name="MnuSortDateDesc" Header="🕒 Timestamp (Newest → Oldest)" Tag="DateDesc" IsCheckable="True" Style="{StaticResource DarkPopupMenuItem}" Click="SortMenuItem_Click"/>
                                            <MenuItem x:Name="MnuSortDateAsc" Header="🕒 Timestamp (Oldest → Newest)" Tag="DateAsc" IsCheckable="True" Style="{StaticResource DarkPopupMenuItem}" Click="SortMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Rectangle Width="1" Height="16" Fill="#343446" Margin="6,0,2,0"/>
                            </StackPanel>

                            <!-- "★ Favs Only" + File Type Filter Radio Pills -->
                            <ScrollViewer Grid.Column="1"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Starred Favorites Filter Pill -->
                                    <CheckBox x:Name="ChkFavoritesOnly"
                                              Content="★ Favs Only"
                                              Style="{StaticResource FavFilterPill}"
                                              Checked="ChkFavoritesOnly_Changed"
                                              Unchecked="ChkFavoritesOnly_Changed"
                                              ToolTip="Show only starred favorite items (can be combined with format filters)"/>

                                    <Rectangle Width="1" Height="16" Fill="#343446" Margin="4,0,6,0"/>

                                    <RadioButton Content="All Media" Tag="ALL" IsChecked="True" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="🖼 All Images" Tag="IMAGES" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="🎬 All Videos" Tag="VIDEOS" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="GIF" Tag=".gif" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="JPG" Tag=".jpg;.jpeg;.jfif" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="PNG" Tag=".png" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="WebP" Tag=".webp" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="BMP / TIFF" Tag=".bmp;.tiff;.tif;.ico;.heic;.avif" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="MP4" Tag=".mp4;.m4v" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="MKV" Tag=".mkv" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="AVI" Tag=".avi;.divx" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="MOV" Tag=".mov" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="WMV / WebM / MPG" Tag=".wmv;.webm;.mpg;.mpeg;.flv;.ts;.m2ts" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                    <RadioButton Content="🎵 Audio / MP3" Tag=".mp3;.flac;.wav;.m4a;.ogg;.aac;.wma;.opus" Style="{StaticResource FilterPill}" Checked="FilterPill_Checked"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Right-side Filter Count & Drawer Close Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="TxtFilterCount"
                                           Text="0 items"
                                           Foreground="#9898AA"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Button Content="✕ Hide"
                                        Style="{StaticResource HudButton}"
                                        Padding="6,2"
                                        FontSize="11"
                                        Click="BtnHideFilmstrip_Click"
                                        ToolTip="Hide Filmstrip Drawer (T)"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- VIRTUALIZED THUMBNAIL STRIP -->
                    <ListBox x:Name="FilmstripList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,5"
                             Focusable="False"
                             SelectionChanged="FilmstripList_SelectionChanged"
                             PreviewMouseWheel="FilmstripList_PreviewMouseWheel"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Focusable" Value="False"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FilmstripItem_PreviewMouseLeftButtonDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Width="124" Height="96"
                                                    Background="#1B1B24"
                                                    BorderBrush="#323242"
                                                    BorderThickness="2"
                                                    CornerRadius="5"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail, Mode=OneWay}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="LowQuality"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                                    <!-- Media Type Pill Badge -->
                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Background="#CC101018"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            Margin="4,4,0,0"
                                                            Visibility="{Binding MediaBadgeVisibility}">
                                                        <TextBlock Text="{Binding MediaBadgeText}"
                                                                   Foreground="#88C0D0"
                                                                   FontSize="9.5"
                                                                   FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Bottom filename caption -->
                                                    <Border VerticalAlignment="Bottom" Background="#B80B0B0E" Padding="4,2">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Foreground="#D8D8E4"
                                                                   FontSize="10.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Gold Star Badge if Favorited -->
                                                    <TextBlock Text="★"
                                                               Foreground="#FFD166"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Top"
                                                               Margin="0,2,5,0"
                                                               Visibility="{Binding FavoriteBadgeVisibility}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#6C92BF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#EBCB8B"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Bottom Status Pill -->
            <Border x:Name="BottomHud"
                    Background="#D8141419"
                    BorderBrush="#2A2A35"
                    BorderThickness="0,1,0,0"
                    Padding="14,5"
                    IsHitTestVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtFileInfo"
                               Text="No media loaded"
                               Foreground="#D8D8E2"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtStatusRight"
                               Grid.Column="1"
                               Text="Zoom: 100%  |  C: Snapshot  |  V / Shift+V: Subtitles  |  +/-: Vol Boost  |  F: Star  |  T: Strip"
                               Foreground="#9898AA"
                               FontSize="12"
                               Margin="20,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>